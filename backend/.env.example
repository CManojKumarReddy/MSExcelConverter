# ── Google Sign-In (required for user authentication) ─────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Add http://localhost:5173 to Authorized JavaScript origins (dev)
#    and your production domain for prod
# 4. Paste the Client ID below (same value goes in frontend/.env as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# Secret key for signing session tokens — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<random-hex-string>

# Cloud OCR (optional) — powers the admin-mode "AI OCR (cloud)" engine.
# Copy this file to `.env` and fill in ONE of the engines below. When neither is
# set, the app silently uses the built-in Tesseract OCR pipeline.
# Preference order if both are set: Gemini, then Azure.

# ── Google Gemini (recommended free option — NO credit card) ───────────────────
# Get a free API key at https://aistudio.google.com/apikey (just a Google account).
# Note: on the free tier, Google may use your inputs to improve its products —
# keep that in mind for sensitive documents.
GEMINI_API_KEY=<your-gemini-api-key>
# Optional: override the model if the default isn't available on your free tier.
# GEMINI_MODEL=gemini-2.5-flash
# Auto-used when the primary model hits a 429 (quota/rate-limit). Override if needed.
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# ── Azure AI Document Intelligence (alternative — requires an Azure account) ────
# Create a "Document Intelligence" resource in the Azure portal, then copy its
# Endpoint and one of its Keys here.
AZURE_DI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DI_KEY=<your-key>
